# Copy this file to .env and fill in your own Kaggle credentials if you want
# automatic dataset downloads. Never commit your real .env file!
#
# How to get your Kaggle credentials:
# 1. Log in to https://www.kaggle.com
# 2. Go to Settings -> API -> Create New Token
# 3. Either place the downloaded kaggle.json in ~/.kaggle/kaggle.json
#    OR copy the username and key from that file below:

KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here
